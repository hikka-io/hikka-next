{
    "name": "@hikka/api",
    "version": "0.1.0",
    "private": true,
    "description": "Generated TypeScript API layer for Hikka (client + TanStack Query)",
    "types": "./dist/index.d.mts",
    "scripts": {
        "build": "tsup --tsconfig tsconfig.build.json",
        "clean": "rimraf dist",
        "dev": "tsup --watch",
        "api:generate": "openapi-ts && biome format --write src/gen",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "license": "AGPL-3.0-only",
    "author": "olexh",
    "peerDependencies": {
        "@tanstack/react-query": "^5.101.1"
    },
    "dependencies": {
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "^0.99.0",
        "@types/node": "20.9.0",
        "rimraf": "^5.0.1",
        "tsup": "^8.4.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.9"
    }
}
