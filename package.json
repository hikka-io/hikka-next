{
    "name": "hikka-monorepo",
    "private": true,
    "scripts": {
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "check": "biome check --write .",
        "check:ci": "biome check .",
        "lint:ratchet": "biome lint --reporter=json --max-diagnostics=none apps/web/src | node apps/web/scripts/lint-ratchet.mjs",
        "check:structure": "node apps/web/scripts/check-structure.mjs --self-test && node apps/web/scripts/check-structure.mjs",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "dev:web": "turbo run dev --filter=@hikka/web",
        "build:web": "turbo run build --filter=@hikka/web",
        "start:web": "turbo run start --filter=@hikka/web",
        "dev:api": "turbo run dev --filter=@hikka/api",
        "build:api": "turbo run build --filter=@hikka/api",
        "api:generate": "turbo run api:generate --filter=@hikka/api"
    },
    "packageManager": "pnpm@10.33.4",
    "pnpm": {
        "overrides": {
            "@types/react": "19.3.0",
            "@types/react-dom": "19.3.0",
            "react": "19.3.0",
            "react-dom": "19.3.0",
            "mdast-util-to-markdown": "2.1.2"
        },
        "onlyBuiltDependencies": [
            "@swc/core",
            "esbuild"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "turbo": "^2.11.5",
        "typescript": "6.0.3"
    }
}
